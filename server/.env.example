# Copy to server/.env and edit. Every value is optional in development.
PORT=5000
PUBLIC_URL=http://localhost:5000
# REQUIRED in production (any long random string)
JWT_SECRET=change-me
STORE_NAME=Axle & Co.
CURRENCY=INR
LOCALE=en-IN
TAX_RATE=0.18
FREE_SHIPPING_OVER_CENTS=200000
SHIPPING_STANDARD_CENTS=9900
SHIPPING_EXPRESS_CENTS=24900
MERCHANT_EMAIL=orders@example.com

# Payments: leave empty to use the built-in sandbox gateway.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email: leave SMTP_HOST empty and receipts are written to server/outbox/ instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Axle & Co. <no-reply@example.com>"
